DOMAIN=your-name.relay.blindport.com
BLINDPORT_SUBSCRIPTION_ID=12312312-3123-4123-8123-123123123123

# Read https://letsencrypt.org/repository/ before changing this to true.
ACME_TERMS_ACCEPTED=false

# Optional Let's Encrypt account contact.
# ACME_EMAIL=you@example.com

# Compose uses Docker group ID 999 by default. Override it when the socket has
# another group, including rootless Docker: stat -c '%g' "$XDG_RUNTIME_DIR/docker.sock"
# DOCKER_GID=1000
# Replace 1000 below with your user ID.
# DOCKER_SOCKET_PATH=/run/user/1000/docker.sock

# Prefer a digest-pinned image from the matching Blindport release.
# BLINDPORTD_IMAGE=ghcr.io/blindport/blindportd@sha256:replace-me
