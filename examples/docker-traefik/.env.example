BASE_DOMAIN=example.com
APP_HOSTNAME=app.example.com
BLINDPORT_SUBSCRIPTION_ID=12312312-3123-4123-8123-123123123123
ACME_EMAIL=owner@example.com
DOCKER_GID=999

# Prefer digest-pinned images for durable deployments.
# BLINDPORTD_IMAGE=ghcr.io/blindport/blindportd@sha256:replace-me
# TRAEFIK_IMAGE=traefik@sha256:replace-me

# Rootless Docker usually uses this socket. Replace 1000 with your user ID.
# DOCKER_SOCKET_PATH=/run/user/1000/docker.sock
