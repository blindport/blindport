DOMAIN=your-name.relay.blindport.com
BLINDPORT_SUBSCRIPTION_ID=12312312-3123-4123-8123-123123123123

# Optional. Let's Encrypt registration works without an email address.
# ACME_EMAIL=you@example.com

# Rootless Docker usually uses this socket. Replace 1000 with your user ID.
# DOCKER_SOCKET_PATH=/run/user/1000/docker.sock

# Rootful Docker only: run blindportd as the owner of the dashboard-created
# token/state and add the Docker socket's group. Use the command in README.md.
# BLINDPORTD_USER=1000:1000
# DOCKER_GID=999
