{
	admin off
	log default {
		exclude http.log.error
	}
	http_port 8080
	https_port 8443
	email {$ACME_EMAIL}
	grace_period 20s
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 64KB
	}
}

{$API_DOMAIN} {
	request_body {
		max_size 1MB
	}

	@relay_internal {
		path /internal/v1/* /internal/v2/*
		remote_ip {$RELAY_PRIVATE_CIDRS}
	}
	@internal path /internal/*
	@admin_allowed {
		path /admin* /api/v1/admin/* /api/v2/admin/*
		remote_ip {$ADMIN_PRIVATE_CIDRS}
	}
	@admin path /admin* /api/v1/admin/* /api/v2/admin/*

	handle @relay_internal {
		reverse_proxy backend:8000
	}
	handle @internal {
		respond 404
	}
	handle @admin_allowed {
		reverse_proxy backend:8000
	}
	handle @admin {
		respond 404
	}
	handle {
		reverse_proxy backend:8000
	}
}
