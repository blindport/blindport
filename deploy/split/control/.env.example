BACKEND_IMAGE=ghcr.io/blindport/blindport-backend:latest
SECRETS_DIR=./secrets
STATE_DIR=./state

API_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
# Source CIDRs allowed to use bearer admin APIs. Browser administration at
# /admin* is publicly reachable and separately protected by ADMIN_TOKEN.
ADMIN_PRIVATE_CIDRS=198.51.100.25/32
CONTROL_BIND_IP=203.0.113.20
# The relay reaches API_DOMAIN over this private route. These are source CIDRs,
# separated by spaces, that may access the versioned internal APIs.
RELAY_PRIVATE_CIDRS=10.20.0.10/32
PAYMENT_ENABLED_METHODS=lightning
# Apply migration 0016 before adding stablecoin_swap above and setting this true.
STABLECOIN_PAYMENTS_ENABLED=false
STABLECOIN_SWAP_MARKUP_BPS=1000
STABLECOIN_SWAP_INVOICE_EXPIRY_SECONDS=1200
STABLECOIN_SWAP_DEFAULT_ASSET=USDC-BASE
STABLECOIN_SWAP_MIN_INVOICE_SATS=5000
STABLECOIN_CHECKOUT_PROVIDER=lightning_swap
BOLTZ_WEB_URL=https://boltz.exchange
LIGHTNING_SWAP_WEB_URL=https://lightning-swap.com
LIGHTNING_SWAP_DEFAULT_ASSET=USDCSOL
BTC_USD_PRICE_ENABLED=true
BTC_USD_PRICE_REFRESH_SECONDS=300
BTC_USD_PRICE_MAX_STALE_SECONDS=1800
NWC_ALLOWED_RELAY_HOSTS=
NWC_ALLOW_PUBLIC_RELAYS=false
NWC_ALLOW_LEGACY_NIP04=false
PAYMENT_NWC_ADAPTER=mock
REMINDER_EMAIL_ENABLED=false
# Keep email delivery disabled until migration 0022 and SMTP settings are installed.
ANNOUNCEMENT_EMAIL_ENABLED=false
NOTIFICATION_RECONCILIATION_ENABLED=true
NOTIFICATION_RECONCILIATION_INTERVAL_SECONDS=10
NOTIFICATION_RECONCILIATION_BATCH_SIZE=100
NOTIFICATION_RECONCILIATION_STARTUP_GRACE_SECONDS=30
NOTIFICATION_RECONCILIATION_STALE_AFTER_SECONDS=60
NOTIFICATION_DELIVERY_LEASE_SECONDS=45
CREDENTIAL_ENCRYPTION_KEY_FILE=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
# File-backed operator input, mounted as an owner-only secret file.
SMTP_PASSWORD_FILE=
SMTP_FROM_EMAIL=notices@example.com
SMTP_TIMEOUT_SECONDS=10

# Keep disabled until every relay and agent supports signed offline entitlements.
# Enabling requires the backend-only owner-only private-key secret, a stable key ID,
# an exact edge map, and both reuse holds strictly above grace plus 120 seconds.
OFFLINE_ENTITLEMENTS_ENABLED=false
OFFLINE_ENTITLEMENT_GRACE_SECONDS=604800
OFFLINE_ENTITLEMENT_KEY_ID=
OFFLINE_ENTITLEMENT_PRIVATE_KEY_FILE=
RELAY_EDGES=
RELAY_HEARTBEAT_STALE_SECONDS=90
RELAY_HEARTBEAT_KEYS_FILE=
RESOURCE_REUSE_QUARANTINE_SECONDS=180
RELAY_RENEWAL_GRACE_SECONDS=604800

# Public DNS observation stores only the latest exact A-set result from each
# configured recursive resolver. It never mutates authoritative DNS.
DNS_SUPERVISION_ENABLED=false
DNS_SUPERVISION_INTERVAL_SECONDS=60
DNS_SUPERVISION_STALE_SECONDS=180
DNS_SUPERVISION_TARGETS=
DNS_SUPERVISION_RESOLVERS=1.1.1.1,8.8.8.8

RELAY_PUBLIC_IP=203.0.113.30
RELAY_CONTROL_HOST=relay.example.com
RELAY_CONTROL_URLS=relay.example.com:5443
RELAY_POOL_DOMAINS=relay.example.com
RELAY_MANAGED_SUFFIXES=relay.example.com
PORT_HA_EDGES=
PORT_HOSTNAME_SUFFIX=
# Historical framed IP listeners only. Leave empty when no retained records need them.
RELAY_FRAMED_IPS=
FRAMED_IP_ENDPOINTS=
RELAY_MANAGED_DOMAIN_CLAIM_TTL_SECONDS=1800
RELAY_DOMAIN_CLAIM_TTL_SECONDS=3600
BANDWIDTH_METRICS_ENABLED=false
BANDWIDTH_RETENTION_DAYS=400
BANDWIDTH_INGEST_MAX_AGE_DAYS=3
BANDWIDTH_CLEANUP_INTERVAL_SECONDS=3600
BANDWIDTH_CLEANUP_BATCH_SIZE=1000
PORT_TCP_RANGE=10000-65535
PORT_UDP_RANGE=10000-65535
PORT_TCP_CAPACITY=4096
PORT_UDP_CAPACITY=4096

IP_YEARLY_SATS=75000
BILLING_YEARLY_ENABLED=true
WIREGUARD_SMTP_EGRESS_FEE_SATS=50000
IP_ENABLED=true
IP_SALES_PAUSED=false
PORT_MONTHLY_SATS=1500
PORT_YEARLY_SATS=15000
PORT_ENABLED=true
PORT_SALES_PAUSED=false
RELAY_MONTHLY_SATS=3000
RELAY_YEARLY_SATS=30000
RELAY_WILDCARD_MONTHLY_SATS=7500
RELAY_WILDCARD_YEARLY_SATS=75000
RELAY_ENABLED=true
RELAY_SALES_PAUSED=false
RELAY_MANAGED_DOMAIN_CAP=25
RELAY_CUSTOMER_DOMAINS_ENABLED=true
ACCOUNT_MAX_NON_CANCELLED_SUBSCRIPTIONS=20
ACCOUNT_MAX_OPEN_PAYMENTS=5
ACCOUNT_MAX_PENDING_RELAY_CLAIMS=2
IP_REUSE_QUARANTINE_SECONDS=604800
RATE_LIMIT_SIGNUP_REQUESTS=10
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_LOGIN_REQUESTS=5
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_SESSION_MAX_AGE_SECONDS=900
RATE_LIMIT_BROWSER_LOGIN_REQUESTS=10
RATE_LIMIT_BROWSER_LOGIN_WINDOW_SECONDS=300
PASSKEYS_ENABLED=false
WEBAUTHN_RP_NAME=Blindport
BROWSER_SESSION_MAX_AGE_SECONDS=2592000
BROWSER_SESSION_MAX_PER_USER=20

# Must match the routed inventory and relay key configured on the split relay host.
WIREGUARD_PUBLIC_IPS=
WIREGUARD_RELAY_PUBLIC_KEY=
WIREGUARD_ENDPOINT=relay.example.com:51820

# LND is not part of this stack. Resolve this over the control host's private network.
LND_REST_URL=https://lnd.internal.example.com:8080
LND_INVOICE_EXPIRY_SECONDS=600
LND_REQUEST_TIMEOUT_SECONDS=10
