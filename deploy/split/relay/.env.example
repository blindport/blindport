RELAY_IMAGE=ghcr.io/blindport/blindport-relay:latest
SECRETS_DIR=./secrets

RELAY_PUBLIC_IP=203.0.113.30
RELAY_CONTROL_HOST=relay.example.com
# Resolve API_DOMAIN to the control host's private IP on this host.
BACKEND_INTERNAL_URL=https://api.example.com
PORT_TCP_RANGE=10000-10031
PORT_UDP_RANGE=10000-10031

RELAY_MAX_CONTROL_HANDSHAKES=256
RELAY_MAX_INGRESS=4096
RELAY_MAX_SNI_PEEKS=512
RELAY_MAX_HTTP_CHALLENGES=64
RELAY_HTTP_CHALLENGE_RATE=600
RELAY_HTTP_CHALLENGE_BURST=100
RELAY_MAX_CONTROL_PER_SOURCE=8
RELAY_MAX_INGRESS_PER_SOURCE=128
RELAY_MAX_STREAMS_PER_TUNNEL=256
