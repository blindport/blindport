RELAY_IMAGE=ghcr.io/blindport/blindport-relay:latest
SECRETS_DIR=./secrets

RELAY_PUBLIC_IP=203.0.113.30
RELAY_CONTROL_HOST=relay.example.com
# Resolve API_DOMAIN to the control host's private IP on this host.
BACKEND_INTERNAL_URL=https://api.example.com
PORT_TCP_RANGE=10000-10031
PORT_UDP_RANGE=10000-10031
RELAY_FRAMED_IPS=
RELAY_FRAMED_PORTS=443

# Keep disabled until every relay and agent supports signed offline entitlements.
# Relays receive this canonical public keyring only, never the signing private key.
OFFLINE_ENTITLEMENTS_ENABLED=false
OFFLINE_ENTITLEMENT_PUBLIC_KEYS=
OFFLINE_ENTITLEMENT_MAX_GRACE_SECONDS=604800
RELAY_EDGE_ID=
RELAY_HEARTBEAT_INTERVAL=30s
RELAY_HEARTBEAT_TOKEN_FILE=

# Apply compose.wireguard.yaml only after the provider routes the configured
# public /32s to this host, net.ipv4.ip_forward=1 is persistent, and
# secrets/wireguard-key is owner-only.
WIREGUARD_PORT=51820
WIREGUARD_MTU=1420
WIREGUARD_RECONCILE_INTERVAL=10s
WIREGUARD_MAX_STALENESS=90s

RELAY_MAX_CONTROL_HANDSHAKES=256
RELAY_MAX_INGRESS=4096
RELAY_MAX_SNI_PEEKS=512
RELAY_MAX_HTTP_CHALLENGES=64
RELAY_HTTP_CHALLENGE_RATE=600
RELAY_HTTP_CHALLENGE_BURST=100
RELAY_MAX_CONTROL_PER_SOURCE=8
RELAY_MAX_INGRESS_PER_SOURCE=128
RELAY_MAX_STREAMS_PER_TUNNEL=256
RELAY_MEMORY_LIMIT=384m
RELAY_CPU_LIMIT=1.0
