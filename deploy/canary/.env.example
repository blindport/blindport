# Use immutable release image references, preferably tag plus manifest digest.
BACKEND_IMAGE=ghcr.io/OWNER/blindport-backend:v0.1.0
RELAY_IMAGE=ghcr.io/OWNER/blindport-relay:v0.1.0
SECRETS_DIR=./secrets/example
STATE_DIR=./state
DOWNLOADS_DIR=./downloads
CADDYFILE=./Caddyfile

# Keep these production defaults except during a source-restricted pre-LND test.
ENVIRONMENT=production
PAYMENT_LIGHTNING_ADAPTER=lnd
# Required before enabling NWC. Use exact trusted relay hostnames, no wildcards.
NWC_ALLOWED_RELAY_HOSTS=
PAYMENT_NWC_ADAPTER=mock
# Keep disabled until migration 0011 plus LNemail/admin-NWC secrets are installed.
REMINDER_EMAIL_ENABLED=false
LNEMAIL_BASE_URL=https://lnemail.net
LNEMAIL_MAX_SEND_PRICE_SATS=100
CREDENTIAL_ENCRYPTION_KEY_FILE=
LNEMAIL_ACCESS_TOKEN_FILE=
LNEMAIL_ADMIN_NWC_URI_FILE=

API_DOMAIN=api.example.com
ONION_HOST=replace-with-v3-onion-host.onion
BLINDPORTD_VERSION=dev
ACME_EMAIL=operator@example.com
ADMIN_PRIVATE_CIDRS=198.51.100.25/32
PUBLIC_IP=203.0.113.10
RELAY_CONTROL_HOST=relay.example.com
RELAY_POOL_DOMAINS=relay.example.com
RELAY_MANAGED_SUFFIXES=relay.example.com
RELAY_DOMAIN_CLAIM_TTL_SECONDS=7200

IP_MONTHLY_SATS=7500
IP_YEARLY_SATS=75000
BILLING_YEARLY_ENABLED=false
IP_ENABLED=true
IP_SALES_PAUSED=false
PORT_MONTHLY_SATS=1500
PORT_YEARLY_SATS=15000
PORT_ENABLED=true
PORT_SALES_PAUSED=false
RELAY_MONTHLY_SATS=3000
RELAY_YEARLY_SATS=30000
RELAY_ENABLED=true
RELAY_SALES_PAUSED=false
RELAY_MANAGED_DOMAIN_CAP=25
RELAY_CUSTOMER_DOMAINS_ENABLED=true
ACCOUNT_MAX_NON_CANCELLED_SUBSCRIPTIONS=20
ACCOUNT_MAX_OPEN_PAYMENTS=5
RATE_LIMIT_SIGNUP_REQUESTS=10
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_LOGIN_REQUESTS=5
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=300
PORT_TCP_RANGE=10000-10255
PORT_UDP_RANGE=10000-10255
RELAY_CONTROL_LISTENERS=127.0.0.1:55443

# LND remains external. Route this name privately and mount only invoice.macaroon.
LND_REST_URL=https://lnd.internal.example.com:8080
LND_INVOICE_EXPIRY_SECONDS=600
LND_REQUEST_TIMEOUT_SECONDS=10

# This canary is intentionally bounded for manual and friends testing, not HA.
RELAY_MAX_CONTROL_HANDSHAKES=128
RELAY_MAX_INGRESS=256
RELAY_MAX_SNI_PEEKS=128
RELAY_MAX_HTTP_CHALLENGES=32
RELAY_HTTP_CHALLENGE_RATE=600
RELAY_HTTP_CHALLENGE_BURST=100
RELAY_MAX_CONTROL_PER_SOURCE=8
RELAY_MAX_STREAMS_PER_TUNNEL=128

# Optional per-container ceilings. Lower CPU limits on one-vCPU canaries.
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=2.0
MIGRATE_MEMORY_LIMIT=768m
MIGRATE_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=2.0
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=1.0
RELAY_MEMORY_LIMIT=768m
RELAY_CPU_LIMIT=2.0
SNI_MUX_MEMORY_LIMIT=256m
SNI_MUX_CPU_LIMIT=1.0
